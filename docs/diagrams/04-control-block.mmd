config:
  flowchart:
    wrappingWidth: 320
    nodeSpacing: 45
    rankSpacing: 60
    padding: 10
  themeVariables:
    fontSize: 18px
---
flowchart LR
  subgraph IN["INPUT"]
    direction TB
    MAX["MAX30102<br/>0x57 · I2C<br/>HR + SpO2"]
    MCP["MCP9808<br/>0x18 · I2C<br/>body temperature"]
    MPU["MPU6050<br/>0x69 · I2C<br/>fall detection"]
    RTC["DS3231<br/>0x68 · I2C<br/>timestamp from NTP"]
    BTN["SOS button<br/>GPIO4 · interrupt"]
  end

  ESP["<b>ESP32 DevKit</b><br/><br/>acquisition and filtering<br/>HR / SpO2 computation<br/>threshold evaluation<br/>fall rule<br/>status word<br/>time stamping"]

  subgraph OUT["OUTPUT"]
    direction TB
    WORD["Status word<br/>FEELING WELL · CHECK NEEDED · ALERT<br/>MEASURING · SOS-HELP"]
    BUZZ["Piezo buzzer<br/>GPIO27 · 10 s"]
    SMS["SIM900A SMS<br/>up to 3 caregivers"]
    CLOUD["Cloud record<br/>every 2 s (see Figure 8)"]
  end

  MAX --> ESP
  MCP --> ESP
  MPU --> ESP
  RTC --> ESP
  BTN --> ESP
  ESP --> WORD
  ESP --> BUZZ
  ESP --> SMS
  ESP --> CLOUD

  PWR["POWER<br/>3.3 V from a buck converter for the ESP32 and the sensors;<br/>a separate 5 V / 2 A rail with a bulk capacitor for the cellular module"]
  ESP --- PWR
